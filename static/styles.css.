:root{color-scheme:dark;--bg:#0a101b;--panel:rgba(20,30,47,.92);--line:rgba(165,186,220,.13);--text:#f4f7fc;--muted:#8e9db4;--green:#69e2a0;--blue:#72a8ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.background-glow{position:fixed;z-index:-1;top:-250px;left:30%;width:700px;height:500px;background:radial-gradient(ellipse,rgba(29,98,172,.2),transparent 68%);pointer-events:none}.container{width:min(1180px,calc(100% - 36px));margin:0 auto}.topbar{height:86px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{display:flex;gap:12px;align-items:center;color:var(--text);text-decoration:none;font-size:13px;font-weight:850;letter-spacing:.12em}.brand small{display:block;margin-top:4px;color:var(--muted);font-size:9px;letter-spacing:.22em}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#75aaff,#4774ef);color:#071326;font-size:20px;font-weight:950}.live-label{display:flex;align-items:center;gap:8px;font-size:10px;letter-spacing:.12em;color:#b5c2d6;font-weight:800}.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px #69e2a080}.hero{display:flex;justify-content:space-between;align-items:center;padding:48px 0 34px}.eyebrow{color:var(--green);font-size:11px;letter-spacing:.18em;font-weight:800}h1{margin:10px 0;font-size:clamp(32px,5vw,54px);letter-spacing:-.045em;line-height:1.05}h1 span{color:var(--blue)}.subtitle{color:var(--muted);max-width:570px;line-height:1.6;font-size:14px}.hero-ball{font-size:70px;opacity:.85;filter:drop-shadow(0 12px 24px #0008);padding-right:24px}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}.summary-card{padding:20px 22px;border:1px solid var(--line);border-radius:16px;background:var(--panel)}.summary-label,.summary-note{display:block;color:var(--muted);font-size:11px}.summary-card strong{display:block;margin:9px 0 5px;font-size:27px;letter-spacing:-.04em}.summary-card .updated-value{font-size:17px;letter-spacing:0}.table-panel{overflow:hidden;border:1px solid var(--line);border-radius:18px;background:var(--panel);box-shadow:0 20px 70px #0002}.table-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px 24px;border-bottom:1px solid var(--line)}h2{margin:0 0 6px;font-size:18px}.table-heading p{margin:0;color:var(--muted);font-size:12px}.refresh-button{flex-shrink:0;border:1px solid #35527c;background:#203656;color:#eaf2ff;border-radius:10px;padding:11px 14px;font:inherit;font-size:12px;font-weight:750;cursor:pointer}.refresh-button:hover{background:#2b4770}.refresh-button:disabled{opacity:.55;cursor:wait}.refresh-button span{font-size:17px;vertical-align:-1px;margin-right:5px}.status{padding:12px 24px;color:var(--muted);font-size:12px;border-bottom:1px solid var(--line)}.status.error{color:#ffb5b5;background:#4a1e2b55}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;white-space:nowrap;font-variant-numeric:tabular-nums}th{padding:13px;text-align:right;color:#8192ad;background:#121d2e;font-size:10px;letter-spacing:.08em}td{padding:13px;border-top:1px solid var(--line);text-align:right;font-size:12px;color:#c4cede}th:first-child,td:first-child{padding-left:22px}.club-col,.club-cell{text-align:left}.pos-col{width:54px;text-align:left}.club-cell{min-width:220px}.club{display:flex;align-items:center;gap:10px;color:var(--text);font-weight:750}.crest{width:25px;height:25px;object-fit:contain}.crest-fallback{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#273953;color:#dce7f7;font-size:9px;font-weight:800}.position{color:var(--muted);font-weight:750}.points{color:var(--text);font-weight:900}tr:hover td{background:#ffffff05}tr.top-row td:first-child{box-shadow:inset 3px 0 var(--green)}tr.bottom-row td:first-child{box-shadow:inset 3px 0 #e8788a}.legend{display:flex;flex-wrap:wrap;gap:16px;padding:16px 22px;border-top:1px solid var(--line);color:var(--muted);font-size:10px}.legend span{display:inline-flex;align-items:center;gap:6px}.legend-dot{width:7px;height:7px;border-radius:50%;display:inline-block}.legend-dot.top{background:var(--green)}.legend-dot.bottom{background:#e8788a}footer{display:flex;justify-content:space-between;gap:18px;padding:22px 2px 32px;color:#6f7f97;font-size:10px}@media(max-width:700px){.container{width:min(100% - 22px,1180px)}.topbar{height:70px}.hero{padding:32px 0 24px}.hero-ball{font-size:44px;padding-right:0}.summary-grid{grid-template-columns:1fr;gap:9px}.summary-card{padding:15px 17px}.summary-card strong{font-size:23px}.table-heading{align-items:flex-start;flex-direction:column;padding:19px 17px}.status{padding:12px 17px}footer{flex-direction:column}}
.stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.leader-value{font-size:20px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.charts-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0 0 22px}.chart-panel{min-width:0;padding:22px;border:1px solid var(--line);border-radius:18px;background:var(--panel)}.chart-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px}.chart-heading p{margin:0;color:var(--muted);font-size:11px;line-height:1.5}.chart-tag{padding:6px 8px;border-radius:7px;background:#72a8ff18;color:var(--blue);font-size:9px;font-weight:850;letter-spacing:.12em}.bar-chart{display:grid;gap:13px}.bar-row{display:grid;grid-template-columns:20px minmax(78px,110px) minmax(30px,1fr) 26px;align-items:center;gap:8px}.bar-rank{color:var(--muted);font-size:10px}.bar-team,.goal-team{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;font-weight:700}.bar-track,.goal-track{height:9px;overflow:hidden;border-radius:10px;background:#ffffff0c}.bar-fill{height:100%;border-radius:10px;background:linear-gradient(90deg,#4774ef,#72a8ff);min-width:2px}.bar-row:first-child .bar-fill{background:linear-gradient(90deg,#36b77b,#69e2a0)}.bar-value{font-size:11px;text-align:right}.chart-legend{display:flex;gap:14px;margin:-7px 0 17px;color:var(--muted);font-size:10px}.chart-legend span{display:flex;align-items:center;gap:6px}.key{display:inline-block;width:8px;height:8px;border-radius:3px;flex-shrink:0}.goals-for{background:#69e2a0}.goals-against{background:#e8788a}.goals-chart{display:grid;gap:12px}.goal-row{display:grid;grid-template-columns:minmax(75px,105px) minmax(70px,1fr) 55px;gap:10px;align-items:center}.goal-bars{display:grid;gap:5px}.goal-track{height:6px}.goal-fill{height:100%;border-radius:8px;min-width:1px}.goal-numbers{font-size:10px;text-align:right;color:#c4cede;font-variant-numeric:tabular-nums}.results-panel{grid-column:1/-1}.results-content{display:flex;align-items:center;justify-content:center;gap:38px;padding:6px 0 12px}.donut{width:148px;height:148px;display:grid;place-items:center;border-radius:50%;position:relative}.donut:before{content:"";position:absolute;inset:15px;border-radius:50%;background:#152034}.donut>div{position:relative;display:grid;text-align:center;gap:4px}.donut strong{font-size:25px}.donut span{font-size:10px;color:var(--muted)}.results-legend{display:grid;gap:15px;min-width:170px}.results-legend>div{display:grid;grid-template-columns:10px 1fr auto;align-items:center;gap:9px;font-size:12px;color:var(--muted)}.results-legend strong{color:var(--text);font-size:14px}.wins{background:#69e2a0}.draws{background:#72a8ff}.losses{background:#e8788a}.chart-placeholder{color:var(--muted);font-size:12px}@media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.charts-grid{grid-template-columns:1fr}.results-panel{grid-column:auto}}@media(max-width:520px){.stats-grid{grid-template-columns:1fr}.chart-panel{padding:17px}.bar-row{grid-template-columns:17px minmax(70px,90px) minmax(25px,1fr) 22px;gap:6px}.goal-row{grid-template-columns:80px minmax(60px,1fr) 48px;gap:7px}.results-content{gap:20px}.donut{width:125px;height:125px}.donut:before{inset:13px}.results-legend{min-width:125px}}
